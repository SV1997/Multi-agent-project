// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  guest
  legal_team
  hr_team
  support_team
  engineering_team
  admin
  superadmin
}

enum MessageRole {
  USER
  ASSISTANT
}
model User {
  id             Int             @id @default(autoincrement())
  name           String
  Email          String          @unique
  role           Role            @default(guest)
  password       String
  createdAT      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  ingestionLogs  IngestionLog[]
  flaggedAnswers FlaggedAnswer[]
  pendingRevieww PendingReview[]
  session Session[]
  refreshToken RefreshToken[]
  employeeData EmployeeData[]
  legalContract LegalContract[]
  Deployment    Deployment[]
  tickets       Tickets[]
}

model Session {
id  String @id @default(uuid())
thread_id String @unique
userId Int
user User @relation(fields:[userId], references: [id])
messages Message[]
pendingReview PendingReview[]
created_At DateTime @default(now())
updatedAt DateTime @updatedAt
}


model Message{
id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])
  role      MessageRole
  content   String
  turnId    String
  createdAt DateTime @default(now())

  @@unique([sessionId,role,turnId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model IngestionLog {
  id         Int      @id @default(autoincrement())
  user_id    Int
  user       User     @relation(fields: [user_id], references: [id])
  namespace  String
  sources    Json
  status     String
  created_At DateTime @default(now())
}

model FlaggedAnswer {
  id              Int      @id @default(autoincrement())
  flaggedByUserId Int
  user            User     @relation(fields: [flaggedByUserId], references: [id])
  domain          String
  answer          String
  Sources         Json
  reason          String?
  created_At      DateTime @default(now())
}

model PendingReview {
  id            Int       @id @default(autoincrement())
  threadId      String    @unique
  userId        Int
  user          User      @relation(fields: [userId], references: [id])
  domain        String
  answer        String
  turnId        String?
  sessionId     String
  session       Session @relation(fields: [sessionId], references: [id])
  sources       Json
  confidence    Float
  faithfulnescore       Float?
  context               String[] @default([])
  answerRelevancyScore  Float?
  evaluatedAt           DateTime?
  Flagged               Boolean?
  createdAt     DateTime  @default(now())
  resolved      Boolean   @default(false)
  resolvedAt    DateTime?
}

model EmployeeData{
    id            Int       @id @default(autoincrement())
    employee_email     String  @unique
    user          User @relation(fields:[employee_email], references: [Email])
    leave_balance         Int
    leave_type        String
    ctc                Float @default(0.0)
}

enum Status {
 pending
 resolved
 rejected
}


model Tickets {
  id              Int      @id @default(autoincrement())
  ticket_id       String   @unique
  employee_email  String
  user            User     @relation(fields: [employee_email], references: [Email])
  pourpose        String
  created_At      DateTime @default(now())
  status          Status   @default(pending)
  @@map("TICKETS")
}

enum ContractStatus {
  active
  expiring_soon
  expired
  under_negotiation
}

model LegalContract {
  id              Int            @id @default(autoincrement())
  contract_number String         @unique
  counterparty    String
  managed_by_email String
  managedBy       User           @relation(fields: [managed_by_email], references: [Email])
  status          ContractStatus @default(active)
  expiry_date     DateTime?
  summary         String?
  created_At      DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}



enum DeploymentStatus {
  succeeded
  failed
  in_progress
  rolled_back
}

model Deployment {
  id              Int              @id @default(autoincrement())
  deployment_id   String           @unique
  service_name    String
  triggered_by_email String
  triggeredBy     User             @relation(fields: [triggered_by_email], references: [Email])
  status          DeploymentStatus
  deployed_at     DateTime         @default(now())
}
