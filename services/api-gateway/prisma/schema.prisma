// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  guest
  legal_team
  hr_team
  support_team
  finance_team
  engineering_team
  admin
  superadmin
}

enum MessageRole {
  USER
  ASSISTANT
}
model User {
  id             Int             @id @default(autoincrement())
  name           String
  Email          String          @unique
  role           Role            @default(guest)
  password       String
  createdAT      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  ingestionLogs  IngestionLog[]
  flaggedAnswers FlaggedAnswer[]
  pendingRevieww PendingReview[]
  session        Session[]
  refreshToken   RefreshToken[]
  employeeData   EmployeeData[]
  managedContracts   LegalContract[] @relation("ContractManager")
  assignedContracts  LegalContract[] @relation("ContractAssignee")
  Deployment     Deployment[]
  ownedTickets   Tickets[] @relation("TicketOwner")
  assignedTickets Tickets[] @relation("TicketAssignee")
  LeaveRecord    LeaveRecord[]
  ContractReview  ContractReview[]
  ownedClaims    ExpenseClaim[] @relation("ClaimOwner")
  assignedClaims ExpenseClaim[] @relation("ClaimAssignee")
  ExpenseReview ExpenseReview[]
  TicketReview  TicketReview[]
}

model Session {
  id            String          @id @default(uuid())
  thread_id     String          @unique
  userId        Int
  user          User            @relation(fields: [userId], references: [id])
  messages      Message[]
  pendingReview PendingReview[]
  created_At    DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Message {
  id        String      @id @default(uuid())
  sessionId String
  session   Session     @relation(fields: [sessionId], references: [id])
  role      MessageRole
  content   String
  turnId    String
  createdAt DateTime    @default(now())

  @@unique([sessionId, role, turnId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model IngestionLog {
  id         Int      @id @default(autoincrement())
  user_id    Int
  user       User     @relation(fields: [user_id], references: [id])
  namespace  String
  sources    Json
  status     String
  created_At DateTime @default(now())
}

model FlaggedAnswer {
  id              Int      @id @default(autoincrement())
  flaggedByUserId Int
  user            User     @relation(fields: [flaggedByUserId], references: [id])
  domain          String
  answer          String
  Sources         Json
  reason          String?
  created_At      DateTime @default(now())
}

model PendingReview {
  id                    Int       @id @default(autoincrement())
  threadId              String    @unique
  userId                Int
  user                  User      @relation(fields: [userId], references: [id])
  domain                String
  answer                String
  turnId                String?
  sessionId             String
  session               Session   @relation(fields: [sessionId], references: [id])
  sources               Json
  confidence            Float
  faithfulnescore       Float?
  context               String[] @default([])
  answerRelevancyScore Float?
  evaluatedAt           DateTime?
  Flagged               Boolean?
  createdAt             DateTime  @default(now())
  resolved              Boolean   @default(false)
  resolvedAt            DateTime?
}

model EmployeeData{
    id            Int       @id @default(autoincrement())
    employee_email     String  @unique
    user          User @relation(fields:[employee_email], references: [Email])
    leave_balance         Int
    leave_type        String
    ctc                Float @default(0.0)
}

enum Status {
 pending
 resolved
 rejected
 escalated
}

model TicketReview{
  id              Int            @id @default(autoincrement())
  reason        String
  reviewedByUser    String
  reviewedBy        User @relation(fields: [reviewedByUser], references: [Email])
  ticketId        String
  ticket_id Tickets @relation(fields: [ticketId], references: [ticket_id])
  createdAt DateTime @default(now())
}

model Tickets {
  id              Int      @id @default(autoincrement())
  ticket_id       String   @unique
  employee_email  String
  user            User     @relation("TicketOwner", fields: [employee_email], references: [Email])
  assigned_to     String?
  assigned_employee User?  @relation("TicketAssignee", fields: [assigned_to], references: [Email])
  pourpose        String
  created_At      DateTime @default(now())
  status          Status   @default(pending)
  TicketReview  TicketReview[]
  @@map("TICKETS")
}

enum ContractStatus {
  active
  expiring_soon
  expired
  under_negotiation
  under_review
}

model ContractReview{
  id              Int            @id @default(autoincrement())
  reason        String
  reviewedByUser    String
  reviewedBy        User @relation(fields: [reviewedByUser], references: [Email])
  contract        String
  contractNumber LegalContract @relation(fields: [contract], references: [contract_number])
  createdAt DateTime @default(now())
}

model LegalContract {
  id              Int            @id @default(autoincrement())
  contract_number String         @unique
  counterparty    String
  managed_by_email String
  managedBy       User           @relation("ContractManager", fields: [managed_by_email], references: [Email])
  assigned_to     String?
  assigned_employee User?        @relation("ContractAssignee", fields: [assigned_to], references: [Email])
  status          ContractStatus @default(active)
  expiry_date     DateTime?
  summary         String?
  created_At      DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  ContractReview  ContractReview[]
}



enum DeploymentStatus {
  succeeded
  failed
  in_progress
  rolled_back
}

model Deployment {
  id              Int              @id @default(autoincrement())
  deployment_id   String           @unique
  service_name    String
  triggered_by_email String
  triggeredBy     User             @relation(fields: [triggered_by_email], references: [Email])
  status          DeploymentStatus
  deployed_at     DateTime         @default(now())
}

model BM25Index {
  namespace String @id
  indexData Bytes
  updatedAt DateTime @updatedAt
  @@map("bm25_indexes")
}

model DocExtraction {
  id             Int      @id @default(autoincrement())
  doc_id         String
  version        Int
  namespace      String
  source         String
  counterparty   String?
  expiry_date    DateTime? @db.Date
  value          Decimal?  @db.Decimal(18, 2)
  currency       String?
  auto_renews    Boolean?
  needs_review   Boolean  @default(false)
  review_reasons String[]
  details        Json
  extracted_at   DateTime @default(now())

  @@unique([doc_id, version])
  @@index([namespace, expiry_date])
  @@map("doc_extractions")
}

model LeaveRecord{
  id Int @id @default(autoincrement())
  leave_applied_by String
  employee_id User @relation(fields:[leave_applied_by], references:[Email])
  start_date DateTime
  end_date DateTime
  leave_type String
  reason String
  total_number_of_days Int
}

enum ClaimStatus{
  pending
  approved
  rejected
  flagged
}

model ExpenseReview{
  id              Int            @id @default(autoincrement())
  reason        String
  reviewedByUser    String
  reviewedBy        User @relation(fields: [reviewedByUser], references: [Email])
  claim        String
  claim_id ExpenseClaim @relation(fields: [claim], references: [claim_id])
  createdAt DateTime @default(now())
}

model ExpenseClaim{
  id  Int  @id @default(autoincrement())
  claim_id  String @unique()
  assigned_to String
  assigned_employee  User @relation("ClaimAssignee",fields: [assigned_to], references:[Email])
  employee_email  String
  employee  User @relation("ClaimOwner",fields: [employee_email], references:[Email])
  amount Decimal
  status  ClaimStatus @default(pending)
  submitted_at DateTime  @default(now())
  ExpenseReview ExpenseReview[]
}

model ThreadFacts{
  id Int @id @default(autoincrement())
  thread_id String
  slot String
  value String
  value_norm  String
  version Int
  source_turn_id String?
  source_text String
  superseded_by Int?
  superseded_by_fact ThreadFacts? @relation("FactSupersession", fields: [superseded_by], references: [id])
  supersedes ThreadFacts[] @relation("FactSupersession")
  created_at DateTime @default(now())
  retracted Boolean @default(false)
  @@unique([thread_id,slot,version])
}